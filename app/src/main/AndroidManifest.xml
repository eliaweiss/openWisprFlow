<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OwfApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Owf">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <!-- The reader pop-up: "Read aloud" in the text-selection menu of other apps. -->
        <activity
            android:name=".ReaderActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/read_aloud_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Owf.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Summarize" in the text-selection menu: the same pop-up, reading a Mercury summary. -->
        <activity-alias
            android:name=".SummarizeSelection"
            android:exported="true"
            android:label="@string/summarize_label"
            android:targetActivity=".ReaderActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- Accessibility shortcuts, assignable to the accessibility button by these names. The
             first keeps its earlier component name so existing button assignments still work. -->
        <activity-alias
            android:name=".ClipboardReadActivity"
            android:exported="true"
            android:label="@string/shortcut_read_label"
            android:targetActivity=".ReaderActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.ACCESSIBILITY_SHORTCUT_TARGET" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityshortcut.target"
                android:resource="@xml/shortcut_read_clipboard" />
        </activity-alias>

        <activity-alias
            android:name=".SummarizeClipboard"
            android:exported="true"
            android:label="@string/shortcut_summarize_label"
            android:targetActivity=".ReaderActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.ACCESSIBILITY_SHORTCUT_TARGET" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityshortcut.target"
                android:resource="@xml/shortcut_summarize_clipboard" />
        </activity-alias>

        <service
            android:name=".DictationAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dictation_accessibility" />
        </service>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone|shortService" />
    </application>
</manifest>
