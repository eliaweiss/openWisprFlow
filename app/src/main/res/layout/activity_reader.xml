<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <TextView
        android:id="@+id/reader_title"
        style="@style/Owf.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/text_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/reader_progress"
            style="@android:style/Widget.Material.ProgressBar.Small"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/reader_status"
            style="@style/Owf.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/reader_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:fadeScrollbars="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/reader_text"
            style="@style/Owf.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/reader_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/reader_previous"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="@drawable/button_tonal"
            android:contentDescription="@string/reader_previous"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/reader_play"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/button_filled"
            android:contentDescription="@string/reader_pause"
            android:src="@drawable/ic_pause"
            android:tint="@color/button_filled_text" />

        <ImageButton
            android:id="@+id/reader_next"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="@drawable/button_tonal"
            android:contentDescription="@string/reader_next"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/reader_copy"
            style="@style/Owf.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/summary_copy" />

        <Button
            android:id="@+id/reader_close"
            style="@style/Owf.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/summary_close" />
    </LinearLayout>
</LinearLayout>
