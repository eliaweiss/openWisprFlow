<?xml version="1.0" encoding="utf-8"?>
<!-- The thin light ring keeps the bubble visible on backgrounds of its own colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/bubble_translate" />
    <stroke android:width="2dp" android:color="@color/bubble_ring" />
</shape>
